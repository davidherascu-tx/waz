# ─── Google Search Console ────────────────────────────────────────────
# Bestätigungs-Code aus der Search Console (Methode "HTML-Tag").
# In der Search Console: Property hinzufügen -> URL-Präfix -> HTML-Tag.
# Dort steht <meta name="google-site-verification" content="XYZ..." />.
# Nur den Wert von content= hier eintragen, dann neu deployen.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ─── Domain ───────────────────────────────────────────────────────────
# Wird für Canonical-URLs, Sitemap und robots.txt genutzt.
# Ohne Eintrag gilt der Standard aus lib/site.ts (https://www.waz-bm.de).
# Für Test-/Staging-Umgebungen hier die jeweilige Domain eintragen.
NEXT_PUBLIC_SITE_URL=https://www.waz-bm.de

# ─── Kontaktformular (Resend) ─────────────────────────────────────────
# Ohne diesen Schlüssel meldet das Formular einen Konfigurationsfehler
# (der Build läuft aber durch).
RESEND_API_KEY=

# Empfänger der Kontaktanfragen.
CONTACT_MAIL_TO=info@waz-bm.de

# Absender. "onboarding@resend.dev" ist nur die Testadresse von Resend und
# darf ausschließlich an die eigene Konto-Adresse senden. Für den Echtbetrieb
# eine eigene Domain in Resend verifizieren, z. B.:
# CONTACT_MAIL_FROM=WAZ Webseite <noreply@waz-bm.de>
CONTACT_MAIL_FROM=WAZ Webseite <onboarding@resend.dev>
